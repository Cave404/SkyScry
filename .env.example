# ============================================================================
# SkyScry v0.0.17 — Environment Variables Template (.env.example)
# ============================================================================
# Copy this file to `.env` when deploying via Docker Compose or TrueNAS SCALE:
#   cp .env.example .env
# ============================================================================

# System Timezone
TZ=UTC

# Host Port for the SkyScry WebUI & REST API
SKYSCRY_PORT=8080

# TrueNAS SCALE Host Dataset Paths (or ./data and ./config for local Docker)
SKYSCRY_DATA_DIR=/mnt/pool/appdata/skyscry/data
SKYSCRY_CONFIG_DIR=/mnt/pool/appdata/skyscry/config

# Automatically pull latest GitHub commits & pip packages on container start
AUTO_UPDATE_ON_START=true

# Station Coordinates for Open-Meteo Barometric Pressure (inHg/hPa) & 48h Backfill
LATITUDE=
LONGITUDE=

# Optional Cloudflare Zero Trust Tunnel Token
# When set, `cloudflared` exposes `http://skyscry:8080` securely over HTTPS
# without opening any ports on your router.
CLOUDFLARE_TUNNEL_TOKEN=

# Optional Admin Security PIN for Public Cloudflare Deployments
# Leave ADMIN_PIN blank and READ_ONLY_PUBLIC=false for unrestricted LAN access.
# If ADMIN_PIN is set (e.g., ADMIN_PIN=1234), public visitors can view all live
# dashboards and historical charts, while modifying sensor settings or running
# maintenance actions requires entering the PIN.
# If READ_ONLY_PUBLIC=true without an ADMIN_PIN, write endpoints are locked.
ADMIN_PIN=
READ_ONLY_PUBLIC=false

